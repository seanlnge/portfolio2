---
const { current = "" } = Astro.props;
---

<nav class="fixed w-full h-16 bg-transparent z-50! p-4 flex justify-center items-center gap-8 font-header text-slate-300 hover:text-white transition-all duration-300">
  <a class={current === "home" ? "active" : ""} href="/">Home</a>
  <a class={current === "projects" ? "active" : ""} href="/projects">Projects</a>
  <a class={current === "contact" ? "active" : ""} href="/contact">Contact</a>
</nav>
