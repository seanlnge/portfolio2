---
import "../styles/globals.css";
import "../styles/fonts.css";
import Nav from "./Nav.astro";

const { title = "Sean Lange", description = "", current = "" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {description ? <meta name="description" content={description} /> : null}
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link
      href="https://fonts.googleapis.com/css2?family=Raleway&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat&display=swap"
      rel="stylesheet"
    />
    <link href="https://fonts.googleapis.com/css2?family=Lato&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header>
      <Nav current={current} />
    </header>
    <main class="w-full">
      <slot />
    </main>
    <footer class="relative z-30 bg-m-primary-black border-t border-m-primary-light/20">
      <div class="max-w-6xl mx-auto px-6 md:px-12 lg:px-16 py-10">
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div class="space-y-2">
            <p class="font-header text-lg text-m-white">Sean Lange</p>
            <p class="text-sm text-slate-400">Software Engineer & Founder</p>
          </div>
          <div class="flex flex-wrap items-center gap-4 text-sm font-semibold text-slate-300">
            <a class="hover:text-m-white transition" href="/">Home</a>
            <a class="hover:text-m-white transition" href="/projects">Projects</a>
            <a class="hover:text-m-white transition" href="/contact">Contact</a>
            <a class="hover:text-m-white transition" href="/media/resume.pdf" target="_blank" rel="noreferrer">
              Resume
            </a>
          </div>
        </div>
        <div class="mt-6 flex flex-col gap-2 text-xs text-slate-500 md:flex-row md:items-center md:justify-between">
          <p>© {new Date().getFullYear()} Sean Lange</p>
          <p>Built with Astro, React, and Tailwind</p>
        </div>
      </div>
    </footer>
  </body>
</html>
