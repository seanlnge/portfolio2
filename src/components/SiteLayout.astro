---
import "../styles/globals.css";
import "../styles/fonts.css";
import Nav from "./Nav.astro";

const { title = "Sean Lange", description = "", current = "" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {description ? <meta name="description" content={description} /> : <meta name="description" content="Full-stack software developer focusing on cloud infrastructure and building production ready end-to-end web applications." />}
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" />
    <link
      href="https://fonts.googleapis.com/css2?family=Raleway&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat&display=swap"
      rel="stylesheet"
    />
    <link href="https://fonts.googleapis.com/css2?family=Lato&display=swap" rel="stylesheet" />

    <!-- Facebook Meta Tags -->
    <meta property="og:url" content="https://seanlange.dev/">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Sean Lange">
    <meta property="og:description" content="Full-stack software developer focusing on cloud infrastructure and building production ready end-to-end web applications.">
    <meta property="og:image" content="/images/self.jpg">

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta property="twitter:domain" content="seanlange.dev">
    <meta property="twitter:url" content="https://seanlange.dev/">
    <meta name="twitter:title" content="Sean Lange">
    <meta name="twitter:description" content="Full-stack software developer focusing on cloud infrastructure and building production ready end-to-end web applications.">
    <meta name="twitter:image" content="/images/self.jpg">
  </head>
  <body>
    <header>
      <Nav current={current} />
    </header>
    <main class="w-full">
      <slot />
    </main>
    <footer class="relative z-30 bg-m-primary-black border-t border-m-primary-light/20">
      <div class="max-w-6xl mx-auto px-6 md:px-12 lg:px-16 py-10">
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div class="space-y-2">
            <p class="font-header text-lg text-m-white">Sean Lange</p>
            <p class="text-sm text-slate-400">Software Engineer</p>
          </div>
          <div class="flex flex-wrap items-center gap-4 text-sm font-semibold text-slate-300">
            <a class="hover:text-m-white transition" href="/">Home</a>
            <a class="hover:text-m-white transition" href="/projects">Projects</a>
            <a class="hover:text-m-white transition" href="/contact">Contact</a>
            <a class="hover:text-m-white transition" href="/media/resume.pdf" target="_blank" rel="noopener noreferrer">
              Resume
            </a>
            <div class="flex items-center gap-3">
              <a
                class="text-slate-400 hover:text-[#0A66C2] transition-colors duration-200"
                href="https://www.linkedin.com/in/seanlnge"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                  <path d="M22.225 0H1.771C.792 0 0 .774 0 1.727v20.545C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.273V1.727C24 .774 23.2 0 22.222 0zM6.812 20.452H3.861V9h2.951v11.452zM5.337 7.433a1.98 1.98 0 1 1 0-3.96 1.98 1.98 0 0 1 0 3.96zM20.447 20.452H16.89v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.345V9h3.41v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.602 0 4.268 2.372 4.268 5.456v6.285z" />
                </svg>
              </a>
              <a
                class="text-slate-400 hover:text-[#6e5494] transition-colors duration-200"
                href="https://github.com/seanlnge"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                  <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.387.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.757-1.333-1.757-1.089-.745.084-.729.084-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.835 2.807 1.305 3.492.998.108-.776.418-1.305.762-1.605-2.665-.305-5.467-1.332-5.467-5.93 0-1.31.469-2.381 1.236-3.221-.123-.303-.536-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.655 1.653.242 2.874.12 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.371.823 1.102.823 2.222 0 1.606-.014 2.896-.014 3.286 0 .322.218.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                </svg>
              </a>
              <a
                class="text-slate-400 hover:text-[#E4405F] transition-colors duration-200"
                href="https://instagram.com/_seanlange"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                  <path d="M7.022 0h9.956A7.022 7.022 0 0 1 24 7.022v9.956A7.022 7.022 0 0 1 16.978 24H7.022A7.022 7.022 0 0 1 0 16.978V7.022A7.022 7.022 0 0 1 7.022 0zm9.437 5.271a1.146 1.146 0 1 0 0 2.292 1.146 1.146 0 0 0 0-2.292zM12 6.544a5.455 5.455 0 1 0 0 10.91 5.455 5.455 0 0 0 0-10.91zm0 1.8a3.655 3.655 0 1 1 0 7.31 3.655 3.655 0 0 1 0-7.31z" />
                </svg>
              </a>
            </div>
          </div>
        </div>
        <div class="mt-6 flex flex-col gap-2 text-xs text-slate-500 md:flex-row md:items-center md:justify-between">
          <p>© {new Date().getFullYear()} Sean Lange</p>
          <p>Built with Astro, React, and Tailwind</p>
        </div>
      </div>
    </footer>
  </body>
</html>
