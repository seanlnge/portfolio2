---
import "../styles/globals.css";
import "../styles/fonts.css";

const { frontmatter } = Astro.props;
const title = frontmatter?.title ?? "Case Study";
const description = frontmatter?.description ?? "";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {description ? <meta name="description" content={description} /> : null}
    <title>{title}</title>
    <base target="_blank" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preload" href="/fonts/chakrapetch/ChakraPetch-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/chakrapetch/ChakraPetch-Regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-m-white text-m-black">
    <main class="w-full">
      <article class="markdown-content pt-0">
        <slot />
      </article>
    </main>
    <script>
      document.querySelectorAll("a[href]").forEach((anchor) => {
        const href = anchor.getAttribute("href") ?? "";
        if (href.startsWith("#") || href.startsWith("mailto:")) return;
        anchor.setAttribute("target", "_blank");
        anchor.setAttribute("rel", "noopener noreferrer");
      });
    </script>
  </body>
</html>
