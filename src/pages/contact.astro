---
import SiteLayout from "../components/SiteLayout.astro";
import { BubbleBackground } from "../components/aesthetic/bubble";
import { Button } from "../components/ui/button";
import { ArrowRight } from "lucide-react";
---

<SiteLayout title="Contact | Sean Lange" description="Get in touch with Sean Lange." current="contact">
	<section class="bg-black w-full min-h-[70vh] flex flex-col items-center text-m-white border-m-primary-light relative overflow-hidden">
		<BubbleBackground interactive={true} className="h-full w-full opacity-40 absolute top-0 left-0 z-10" />
		<div class="relative z-20 w-full max-w-6xl px-6 md:px-12 lg:px-16 py-24 md:py-28">
			<div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] items-start">
				<div class="space-y-6">
					<p class="uppercase tracking-[0.35em] text-xs font-semibold text-m-primary-light/80">
						Contact
					</p>
					<h1 class="font-header text-4xl md:text-5xl lg:text-6xl font-semibold text-m-white">
						Let us build something ambitious.
					</h1>
					<p class="text-base md:text-lg text-slate-300 leading-relaxed">
						I am open to internships, collaborations, and product work. The fastest way to reach
						me is email, but feel free to connect anywhere below.
					</p>
					<div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
						<a href="mailto:seanlange74@gmail.com"></a>
							<Button className="bg-m-primary-white text-m-black tracking-wide font-semibold w-56 hover:bg-m-white hover:text-m-black duration-300">
								Email Me <ArrowRight className="w-4 h-4" />
							</Button>
						</a>
						<a href="/media/resume.pdf" target="_blank" rel="noreferrer"></a>
							<Button className="bg-m-black text-m-white tracking-wide font-semibold w-56 hover:bg-m-primary-white hover:text-m-black duration-300">
								Resume <ArrowRight className="w-4 h-4" />
							</Button>
						</a>
					</div>
					<div class="grid gap-4 sm:grid-cols-2">
						<div class="rounded-2xl border border-m-primary-light/20 bg-m-primary-ultradark/70 p-5 shadow-lg shadow-black/20">
							<p class="text-xs uppercase tracking-[0.3em] text-m-primary-light/80">Email</p>
							<a class="mt-3 block text-slate-200 hover:text-m-white transition" href="mailto:seanlange74@gmail.com">
								seanlange74@gmail.com
							</a>
						</div>
						<div class="rounded-2xl border border-m-primary-light/20 bg-m-primary-ultradark/70 p-5 shadow-lg shadow-black/20">
							<p class="text-xs uppercase tracking-[0.3em] text-m-primary-light/80">Phone</p>
							<a class="mt-3 block text-slate-200 hover:text-m-white transition" href="tel:7272184504">
								(727) 218-4504
							</a>
						</div>
						<div class="rounded-2xl border border-m-primary-light/20 bg-m-primary-ultradark/70 p-5 shadow-lg shadow-black/20">
							<p class="text-xs uppercase tracking-[0.3em] text-m-primary-light/80">Location</p>
							<p class="mt-3 text-slate-200">Tampa, FL</p>
						</div>
						<div class="rounded-2xl border border-m-primary-light/20 bg-m-primary-ultradark/70 p-5 shadow-lg shadow-black/20">
							<p class="text-xs uppercase tracking-[0.3em] text-m-primary-light/80">Availability</p>
							<p class="mt-3 text-slate-200">Internships · Product work · Collabs</p>
						</div>
					</div>
				</div>
				<div class="space-y-4">
					<div class="rounded-3xl border border-m-primary-light/20 bg-m-primary-ultradark/70 p-6 shadow-lg shadow-black/20">
						<p class="uppercase tracking-[0.3em] text-xs font-semibold text-m-primary-light/80">
							Direct
						</p>
						<div class="mt-4 space-y-3 text-slate-200">
							<p class="font-semibold">Email</p>
							<a class="text-slate-300 hover:text-m-white transition" href="mailto:seanlange74@gmail.com">
								seanlange74@gmail.com
							</a>
							<p class="font-semibold pt-3">Phone</p>
							<a class="text-slate-300 hover:text-m-white transition" href="tel:7272184504">
								(727) 218-4504
							</a>
							<p class="font-semibold pt-3">Location</p>
							<p class="text-slate-300">Tampa, FL</p>
						</div>
					</div>
					<div class="rounded-3xl border border-m-primary-light/20 bg-m-primary-ultradark/70 p-6 shadow-lg shadow-black/20">
						<p class="uppercase tracking-[0.3em] text-xs font-semibold text-m-primary-light/80">
							Online
						</p>
						<div class="mt-4 space-y-3 text-slate-200">
							<a
								class="text-slate-300 hover:text-m-white transition block"
								href="https://github.com/seanlnge"
								target="_blank"
								rel="noreferrer"
							>
								github.com/seanlnge
							</a>
							<a
								class="text-slate-300 hover:text-m-white transition block"
								href="https://seanlange.dev"
								target="_blank"
								rel="noreferrer"
							>
								seanlange.dev
							</a>
							<a
								class="text-slate-300 hover:text-m-white transition block"
								href="https://replit.com/@seanlnge"
								target="_blank"
								rel="noreferrer"
							>
								replit.com/@seanlnge
							</a>
						</div>
					</div>
					<div class="rounded-3xl border border-m-primary-light/20 bg-m-primary-ultradark/70 p-6 shadow-lg shadow-black/20">
						<p class="uppercase tracking-[0.3em] text-xs font-semibold text-m-primary-light/80">
							Response Time
						</p>
						<p class="mt-3 text-slate-300 leading-relaxed">
							Usually within 24 hours. If you need something urgent, email is fastest.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>
</SiteLayout>
