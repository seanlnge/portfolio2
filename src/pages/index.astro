---
import SiteLayout from "../components/SiteLayout.astro";
import projectsData from "../data/projects.json";
import { BubbleBackground } from "../components/aesthetic/bubble";
import { Button } from "../components/ui/button";
import { ArrowRight } from "lucide-react";
import ToolIconRows from "../components/ToolIconRows";
import HighlightedProjects from "../components/HighlightedProjects";
import { Image } from "astro:assets";

type Project = {
  description: string;
  link: string;
  image: string;
  code: string;
  caseStudy?: string;
  tools?: string[];
  privateCode?: boolean;
  tags?: string[];
};

type ProjectsData = {
  links: Record<string, { link: string; image: string }>;
  highlights: string[];
  projects: Record<string, Project>;
};

const projects = projectsData as ProjectsData;
const highlightProjects = projects.highlights
  .map((name) => {
    const project = projects.projects[name];
    if (!project) {
      return null;
    }
    return { name, ...project };
  })
  .filter((project): project is { name: string } & Project => project !== null);

const links = Object.entries(projects.links);
---

<SiteLayout title="Sean Lange" description="Portfolio for Sean Lange." current="home">
	<section class="bg-black w-full min-h-screen xl:h-screen flex flex-col xl:flex-row items-center text-m-white border-m-primary-light">
		<BubbleBackground interactive={true}  className="h-full w-full opacity-40 absolute top-0 left-0 z-10" />
		<div class="z-20 rotate-12 xl:rotate-12 scale-150 w-full xl:w-1/2 h-full bottom-0 left-0 absolute origin-top-right bg-m-white/5 hidden xl:block"></div>
		<div class="flex-1 pt-28 pb-8 px-8 md:p-16 xl:p-24 xl:pt-16 h-full flex flex-col gap-8 justify-center relative z-30 text-center xl:text-left">
			<div class="flex flex-col gap-0 items-center justify-center w-full xl:w-min">
				<div class="mx-auto xl:mx-0 h-32 w-32 md:h-40 md:w-40 md:-translate-x-4 translate-y-8 scale-175 rounded-full shadow-lg overflow-hidden bg-m-black/40">
					<img src="images/self.jpg" alt="Sean Lange portrait" width={160} height={160} class="h-full w-full object-cover" />
				</div>
				<div class="font-extrabold font-header text-5xl md:text-6xl xl:text-8xl flex flex-row gap-3 mb-8">
					<h1 class="z-22 text-m-accent-white translate-x-4 lg:translate-x-0 mix-blend-difference">Sean</h1>
					<h1 class="z-21 text-m-black translate-y-3 scale-y-100 lg:-translate-x-4 mix-blend-difference">/</h1>
					<h1 class="z-22 text-m-accent-white -translate-x-4 translate-y-6 lg:-translate-x-8 mix-blend-difference">Lange</h1>
				</div>
			</div>
			<p class="font-normal text-base md:text-lg font-header text-slate-300">Full-stack Software Engineer & Founder</p>
			<div class="flex flex-col md:flex-row justify-center xl:justify-start gap-4">
				<a href="/projects">
					<Button className="bg-m-black text-m-white tracking-wide font-semibold w-64 hover:bg-m-primary-white hover:text-m-black duration-300">
						Projects <ArrowRight className="w-4 h-4" />
					</Button>
				</a>
				<a href="/media/resume.pdf" target="_blank" rel="noreferrer">
					<Button className="bg-m-accent-light text-m-black tracking-wide font-semibold w-64 hover:bg-m-primary-white hover:text-m-black duration-300">
						Resume <ArrowRight className="w-4 h-4" />
					</Button>
				</a>
			</div>
		</div>
		<div class="flex-1 xl:pl-24 relative flex flex-col gap-0 justify-center items-center z-20 pb-16 xl:pb-0">
			<div class="z-30 mr-auto relative translate-y-8 translate-x-8 flex flex-row gap-0 justify-center items-center">
				<div class="z-31 h-32 w-32 rounded-2xl shadow-xl cursor-pointer hover:scale-105 duration-300 shadow-black/80 hover:shadow-black p-2 bg-white">
					<a href="https://www.credly.com/badges/89fa5b44-0ae4-4506-91f8-d0c5b1725cf9/public_url" target="_blank" rel="noreferrer" class="w-full h-full block m-0 p-0">
						<Image src="/images/ibmcloudv6.png" alt="IBM Cloud V6 Certification" width={100} height={100}  class="w-full h-full object-cover" loading="lazy" />
					</a>
				</div>
			</div>
			<div class="z-29 w-64 md:w-80 xl:w-[500px] bg-white rounded-2xl h-64 relative flex flex-row gap-0 justify-center items-center">
				<Image src="/images/multyx.png" alt="Multyx.io" width={400} height={400}  class="rounded-2xl w-full h-full object-cover" />
			</div>
			<div class="z-30 w-64 md:w-80 ml-auto xl:w-[500px] -translate-y-8 -translate-x-8 rounded-2xl relative shadow-xl cursor-pointer hover:scale-105 duration-300 shadow-black/40 hover:shadow-black/60">
				<a href="https://github.com/seanlnge" target="_blank" rel="noreferrer" class="w-full h-full block m-0 p-0">
					<Image src="http://github-profile-summary-cards.vercel.app/api/cards/profile-details?username=seanlnge&theme=aura_dark" alt="GitHub Profile Summary" width={400} height={400}  class="rounded-2xl w-full h-full object-cover" />
				</a>
			</div>
		</div>
	</section>

	<section class="z-30 bg-m-black relative py-24 md:py-32 px-6 md:px-12 xl:px-16 text-m-white">
		<div class="max-w-5xl mx-auto grid gap-10 xl:grid-cols-[1.1fr_0.9fr] items-center">
			<div class="space-y-6">
				<p class="uppercase tracking-[0.35em] text-xs font-semibold text-m-primary-light/80">About</p>
				<h2 class="font-header text-3xl md:text-4xl xl:text-5xl font-semibold text-m-white">
					Using complex cloud infrastructure to ship real products.
				</h2>
				<p class="text-base md:text-lg text-slate-300 leading-relaxed">I build production-ready web applications end-to-end, from UI/UX to cloud infrastructure. Most of my work is TypeScript-first (Next.js/Node), backed by AWS services for deployment, scaling, and automation; allowing the product to ship fast and stay reliable.</p>
			</div>
			<ToolIconRows client:load />
		</div>
	</section>
	<section class="relative z-30 overflow-hidden bg-linear-to-b from-m-primary-black to-m-primary-dark">
		<div class="relative z-10 px-6 md:px-12 xl:px-16 py-24 md:py-32">
			<div class="max-w-6xl mx-auto">
				<div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
					<div class="space-y-3">
						<p class="uppercase tracking-[0.35em] text-xs font-semibold text-m-primary-light/80">
							Highlighted Projects
						</p>
						<h2 class="font-header text-3xl md:text-4xl xl:text-5xl text-m-white font-semibold">
							My best work - so far.
						</h2>
					</div>
					
					<a href="/projects">
						<Button className="bg-m-primary-white text-m-black tracking-wide font-semibold w-48 hover:bg-m-white hover:text-m-black duration-300">
							View All <ArrowRight className="w-4 h-4" />
						</Button>
					</a>
				</div>
				<div class="mt-12">
					<HighlightedProjects projects={highlightProjects} client:load />
				</div>
			</div>
		</div>
	</section>
</SiteLayout>
