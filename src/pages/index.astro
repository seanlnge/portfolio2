---
import SiteLayout from "../components/SiteLayout.astro";
import projectsData from "../data/projects.json";
import { BubbleBackground } from "../components/aesthetic/bubble";
import { buttonVariants } from "../components/ui/button";
import { ArrowRight } from "lucide-react";
import { cn } from "../lib/utils";
import ToolIconRows from "../components/ToolIconRows";
import HighlightedProjects from "../components/HighlightedProjects";
import { Image } from "astro:assets";
import { withOptimizedProjectImages } from "../lib/optimize-images";
import type { Project } from "../lib/projects";
import selfPortrait from "../assets/images/self.jpg";
import ibmCloudBadge from "../assets/images/ibmcloudv6.png";
import hackathonAwards from "../assets/images/hackathon.png";

type ProjectsData = {
  links: Record<string, { link: string; image: string }>;
  highlights: string[];
  projects: Record<string, Project>;
};

const projects = projectsData as ProjectsData;
const optimizedProjects = await withOptimizedProjectImages(projects.projects);
const highlightProjects = projects.highlights
  .map((name) => {
    const project = optimizedProjects[name];
    if (!project) {
      return null;
    }
    return { name, ...project };
  })
  .filter((project): project is { name: string } & Project => project !== null);

const links = Object.entries(projects.links);
---

<SiteLayout title="Sean Lange" description="Portfolio for Sean Lange." current="home">
	<section class="relative overflow-hidden bg-black w-full min-h-screen flex flex-col xl:flex-row items-center text-m-white border-m-primary-light">
		<BubbleBackground client:load interactive={true} className="pointer-events-none h-full w-full opacity-40 absolute inset-0 z-10" />
		<div class="pointer-events-none z-20 rotate-12 scale-150 w-[70%] h-[140%] -bottom-1/4 -left-10 absolute origin-top-right bg-m-white/5 blur-3xl hidden xl:block"></div>
		<div class="flex-1 pt-28 pb-8 px-8 md:p-16 xl:p-24 xl:pt-16 h-full flex flex-col gap-8 justify-center relative z-30 isolate text-center xl:text-left">
			<div class="flex flex-col gap-0 items-center justify-center w-full xl:w-min">
				<div class="mx-auto xl:mx-0 h-32 w-32 md:h-40 md:w-40 md:-translate-x-4 translate-y-8 scale-175 rounded-full shadow-lg overflow-hidden bg-m-black/40">
					<Image src={selfPortrait} alt="Sean Lange portrait" width={320} height={320} densities={[1, 2]} format="webp" quality={70} class="h-full w-full object-cover" />
				</div>
				<div class="font-bold font-header text-5xl md:text-6xl xl:text-8xl flex flex-row gap-3 mb-8">
					<h1 class="z-22 text-m-accent-white translate-x-4 lg:translate-x-0 mix-blend-difference">Sean</h1>
					<h1 class="z-21 text-m-black translate-y-3 scale-y-100 lg:-translate-x-4 mix-blend-difference">/</h1>
					<h1 class="z-22 text-m-accent-white -translate-x-4 translate-y-6 lg:-translate-x-8 mix-blend-difference">Lange</h1>
				</div>
			</div>
			<p class="font-normal text-base md:text-lg font-header text-slate-300">Full-stack Software Engineer</p>
			<div class="flex flex-col md:flex-row justify-center xl:justify-start gap-4">
				<a
					href="/projects"
					class={cn(buttonVariants(), "bg-m-black text-m-white tracking-wide font-semibold w-64 hover:bg-m-primary-white hover:text-m-black duration-300")}
				>
					Projects <ArrowRight className="w-4 h-4" />
				</a>
				<a
					href="/media/resume.pdf"
					target="_blank"
					rel="noopener noreferrer"
					class={cn(buttonVariants(), "bg-m-accent-light text-m-black tracking-wide font-semibold w-64 hover:bg-m-primary-white hover:text-m-black duration-300")}
				>
					Resume <ArrowRight className="w-4 h-4" />
				</a>
			</div>
		</div>
		<div class="flex-1 xl:pl-24 relative flex flex-col gap-0 justify-center items-center z-20 pb-16 xl:pb-0">
			<div class="z-30 mr-auto relative translate-y-8 translate-x-8 flex flex-row gap-0 justify-center items-center">
				<div class="z-31 h-32 w-32 shadow-xl cursor-pointer hover:scale-105 duration-300 shadow-black/80 hover:shadow-black p-2 bg-white">
					<a href="https://www.credly.com/badges/89fa5b44-0ae4-4506-91f8-d0c5b1725cf9/public_url" target="_blank" rel="noopener noreferrer" class="w-full h-full block m-0 p-0">
						<Image src={ibmCloudBadge} alt="IBM Cloud V6 Certification" width={128} height={128} densities={[2]} format="webp" quality={70} class="w-full h-full object-cover" loading="lazy" />
					</a>
				</div>
			</div>
			<div class="z-29 w-64 md:w-80 xl:w-[500px] bg-white h-64 relative flex flex-row gap-0 justify-center items-center hover:scale-105 duration-300 shadow-xl cursor-pointer hover:shadow-black/60">
				<a href="https://devpost.com/seanlnge" target="_blank" rel="noopener noreferrer" class="w-full h-full block m-0 p-0">
					<Image src={hackathonAwards} alt="Hackathon Awards" width={800} height={266} densities={[1, 2]} format="webp" quality={70} class="w-full h-full object-cover object-left" />
				</a>
			</div>
			<div class="z-30 w-64 md:w-80 ml-auto xl:w-[500px] -translate-y-8 -translate-x-8 relative shadow-xl cursor-pointer hover:scale-105 duration-300 shadow-black/40 hover:shadow-black/60">
				<a href="https://github.com/seanlnge" target="_blank" rel="noopener noreferrer" class="w-full h-full block m-0 p-0">
					<Image src="https://github-profile-summary-cards.vercel.app/api/cards/profile-details?username=seanlnge&theme=aura_dark" alt="GitHub Profile Summary" width={400} height={400}  class="w-full h-full object-cover" />
				</a>
			</div>
		</div>
	</section>

	<section class="z-30 bg-m-black relative py-24 md:py-32 px-6 md:px-12 xl:px-16 text-m-white">
		<div class="max-w-5xl mx-auto grid gap-10 xl:grid-cols-[1.1fr_0.9fr] items-center">
			<div class="space-y-6">
				<p class="uppercase tracking-[0.35em] text-xs font-semibold text-m-primary-light/80">About</p>
				<h2 class="font-header text-3xl md:text-4xl xl:text-5xl font-semibold text-m-white">
					Using complex cloud infrastructure to ship real products.
				</h2>
				<p class="text-base md:text-lg text-slate-300 leading-relaxed">I build production-ready web applications end-to-end, from UI/UX to cloud infrastructure. Most of my work is TypeScript-first (Next.js/Node), backed by AWS services for deployment, scaling, and automation; allowing the product to ship fast and stay reliable.</p>
			</div>
			<ToolIconRows />
		</div>
	</section>
	<section class="relative z-30 overflow-hidden bg-linear-to-b from-m-primary-black to-m-primary-dark">
		<div class="relative z-10 px-6 md:px-12 xl:px-16 py-24 md:py-32">
			<div class="max-w-6xl mx-auto">
				<div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
					<div class="space-y-3">
						<p class="uppercase tracking-[0.35em] text-xs font-semibold text-m-primary-light/80">
							Highlighted Projects
						</p>
						<h2 class="font-header text-3xl md:text-4xl xl:text-5xl text-m-white font-semibold">
							My best work - so far.
						</h2>
					</div>
					
					<a
						href="/projects"
						class={cn(buttonVariants(), "bg-m-primary-white text-m-black tracking-wide font-semibold w-48 hover:bg-m-white hover:text-m-black duration-300")}
					>
						View All <ArrowRight className="w-4 h-4" />
					</a>
				</div>
				<div class="mt-12">
					<HighlightedProjects projects={highlightProjects} client:load />
				</div>
			</div>
		</div>
	</section>
</SiteLayout>
