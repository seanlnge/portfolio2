	<section class="about z-20">
		<h2>About</h2>
		<p>
		I am a freshman at the University of South Florida, and have been programming for over
		six years. I started programming in the summer before 7th grade, and have since focused on
		building web applications with Node.js and Typescript. I also have experience in Python,
		Java, Dart, and Rust.
		</p>
	</section>

	<section class="projects">
		<div class="section-header">
			<h2>Highlighted Projects</h2>
			<a class="text-link" href="/projects">View all projects</a>
		</div>
		<div class="project-grid">
			{highlightProjects.map((project) => (
				<article class="project-card">
				<img src={`/images/${project.image}`} alt={project.name} />
				<div>
					<h3>{project.name}</h3>
					<p>{project.description}</p>
					<div class="project-links">
						<a href={project.link} target="_blank" rel="noreferrer">View Project</a>
						<span>·</span>
						<a href={project.code} target="_blank" rel="noreferrer">View Code</a>
					</div>
				</div>
				</article>
			))}
		</div>
	</section>
</SiteLayout>
