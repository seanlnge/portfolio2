---
import SiteLayout from "../components/SiteLayout.astro";
import projectsData from "../data/projects.json";
import ProjectsGrid from "../components/ProjectsGrid";
import { BubbleBackground } from "../components/aesthetic/bubble";
import { Button } from "../components/ui/button";
import { ArrowRight } from "lucide-react";

type Project = {
  description: string;
  link: string;
  image: string;
  code: string;
  tools?: string[];
  privateCode?: boolean;
  tags?: string[];
};

type ProjectsData = {
  links: Record<string, { link: string; image: string }>;
  highlights: string[];
  projects: Record<string, Project>;
};

const projects = projectsData as ProjectsData;
---

<SiteLayout title="Projects | Sean Lange" description="Highlighted and full project list." current="projects">
	<section class="bg-black w-full min-h-[60vh] flex flex-col items-center text-m-white border-m-primary-light relative overflow-hidden">
		<BubbleBackground interactive={true} className="h-full w-full opacity-40 absolute top-0 left-0 z-10" />
		<div class="relative z-20 w-full max-w-6xl px-6 md:px-12 lg:px-16 py-24 md:py-28">
			<div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
				<div class="space-y-4 max-w-2xl">
					<p class="uppercase tracking-[0.35em] text-xs font-semibold text-m-primary-light/80">
						Projects
					</p>
					<h1 class="font-header text-4xl md:text-5xl lg:text-6xl font-semibold text-m-white">
						All the cool things I've built.
					</h1>
					<p class="text-base md:text-lg text-slate-300 leading-relaxed">
						From hackathon wins to long-term product work, here is a full list of my most recent
						builds. Each card includes the primary tools I leaned on.
					</p>
				</div>
				<div class="flex flex-col gap-3">
					
					<a href="/contact">
						<Button className="bg-m-primary-white text-m-black tracking-wide font-semibold w-48 hover:bg-m-white hover:text-m-black duration-300">
							Contact <ArrowRight className="w-4 h-4" />
						</Button>
					</a>
					<a href="/media/resume.pdf" target="_blank" rel="noreferrer">
						<Button className="bg-m-black text-m-white tracking-wide font-semibold w-48 hover:bg-m-primary-white hover:text-m-black duration-300">
							Resume <ArrowRight className="w-4 h-4" />
						</Button>
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="relative z-30 overflow-hidden bg-slate-900">
		<div class="relative z-10 px-6 md:px-12 lg:px-16 py-20 md:py-28">
			<div class="max-w-6xl mx-auto">
				<ProjectsGrid projects={projects.projects} highlights={projects.highlights} client:load />
			</div>
		</div>
	</section>
</SiteLayout>
